server {
    listen 80;
    server_name ${OTEL_HOST};

    # The otel container is created alongside nginx with no depends_on (a tool
    # never gates the stack). A literal `proxy_pass http://otel:3000` is resolved
    # once at nginx start and fails the whole nginx container if the name does
    # not exist yet; a variable forces per-request resolution via Docker DNS.
    resolver 127.0.0.11 valid=10s;
    set $otel_upstream http://otel:3000;

    location / {
        proxy_pass $otel_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Grafana Live websocket.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
